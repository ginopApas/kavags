              }
            },
            "@media (max-width: 767px)": {
              "-webkit-align-items": "center",
              "align-items": "center",
              ".mbr-row": {
                "-webkit-justify-content": "center",
                "justify-content": "center"
              },
              ".content-wrap": {
                "width": "100%"
              }
            },
            ".mbr-section-title": {
              "text-align": "center",
              "color": "#8b7500"
            },
            ".mbr-text, .mbr-section-btn": {
              "text-align": "center",
              "color": "#8b7500"
            },
            ".mbr-description": {
              "text-align": "center",
